# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.0 Project Minimal Configuration
#
CONFIG_PARTITION_TABLE_OFFSET=0xa000

# This board (ESP32-S3-DevKitC-1) has no external USB-UART bridge on UART0
# (GPIO43/44 are unconnected) — only the native USB-Serial/JTAG peripheral
# (GPIO19/20, the single USB-C port) reaches the PC. Console must be that
# peripheral so idf.py monitor's keyboard passthrough (e/p/m/f) actually
# reaches the classifier, not just log output. classifier_placeholder.c
# reads from this same peripheral when it's the console (see its
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG branch).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=128
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n

# BLE (NimBLE) for the fall-emergency phone trigger.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# Peripheral GPIO pins — this board is ESP32-S3-DevKitC-1 N16R8 (16MB quad
# flash + 8MB embedded octal PSRAM). GPIO26-37 are reserved for flash/PSRAM
# on this exact board and must NOT be reused here; the component Kconfig
# defaults (26/32/34/etc.) are only valid for the plain ESP32 DevKit used
# by wisense_hw. FSR must stay on an ADC1 pin (GPIO1-10) since ADC2 is
# unusable while Wi-Fi/CSI is active.
CONFIG_WISENSE_OLED_I2C_SDA_GPIO=8
CONFIG_WISENSE_OLED_I2C_SCL_GPIO=9
CONFIG_WISENSE_LIGHT_RELAY_GPIO=4
CONFIG_WISENSE_LIGHT_LDR_GPIO=5
CONFIG_WISENSE_FSR_GPIO=6
CONFIG_WISENSE_EMERGENCY_BUTTON_GPIO=7
CONFIG_WISENSE_EMERGENCY_BUZZER_GPIO=15
CONFIG_WISENSE_EMERGENCY_LED_GPIO=16
CONFIG_WISENSE_SERVO_GPIO=13
